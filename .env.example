OPENROUTER_API_KEY=your_openrouter_api_key_here

OPENROUTER_MODEL=openai/gpt-oss-20b:free

TAVILY_API_KEY=your_tavily_api_key_here

# Supabase PostgreSQL (required for Vercel; the filesystem fallback is used for local dev)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
AUDIT_JOB_SECRET=change-me-to-a-long-random-string

# Public base URL used to self-trigger audit steps. On Vercel this is derived automatically, so
# only needed for non-Vercel hosting.
# APP_URL=https://your-app.com

# Optional: cap the longest audit stage so it stays under Vercel Hobby's 60s limit.
# Set to 45000 on the Hobby plan, or leave unset on Pro (90s default).
# LIVE_AI_TIMEOUT_MS=45000
